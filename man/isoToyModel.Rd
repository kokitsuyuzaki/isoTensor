\name{isoToyModel}
\docType{methods}
\alias{isoToyModel}

\title{
Toy Model Data for isoTensor
}
\description{
isoToyModel generates a small synthetic dataset for isoTensor with
known ground truth.

With model="matrix", a ground truth cell type fraction matrix A
(individual x cell type, rows sum to 1) and a ground truth
cell-type-by-isoform matrix B are generated, and the bulk isoform
abundance matrix X = A B is returned.

With model="tensor", ground truth factors U (individual x
rank_individual), G (rank_individual x C x rank_isoform), and W
(isoform x rank_isoform) of a partial non-negative Tucker model are
generated, the latent tensor B_nci = sum_pq U_np G_pcq W_iq is formed,
rows of A are drawn from a Dirichlet distribution whose
between-individual variation is controlled by A_variation, and the
bulk matrix is generated as X_ni = sum_c A_nc B_nci. This generator is
for studying the recoverability of the individual-specific latent
tensor B (see notes/tensor-simulation.md in the GitHub repository);
the corresponding fitting algorithm is not implemented yet.

In both cases noise-free data is generated by default, and additive
Gaussian noise (truncated at 0) can be added via noise.
}
\usage{
isoToyModel(model=c("matrix", "tensor"), N=5, C=2, I=6,
  noise=0, seed=NULL,
  rank_individual=2, rank_isoform=2,
  individual_effect=TRUE, effect_cell_types=NULL,
  A_variation="moderate", A_mean=NULL, noise_A=0)
}

\arguments{
\item{model}{
"matrix" (population-level, Phase 1) or "tensor"
(individual-specific partial Tucker ground truth, Phase 2 simulation)
(Default: "matrix").
}
\item{N}{
The number of individuals (Default: 5).
}
\item{C}{
The number of cell types (Default: 2).
}
\item{I}{
The number of isoforms (Default: 6).
}
\item{noise}{
The standard deviation of the additive Gaussian noise added to X.
Negative values after adding noise are truncated to 0 (Default: 0).
}
\item{seed}{
If not NULL, set.seed(seed) is called before the data generation for
reproducibility (Default: NULL).
}
\item{rank_individual}{
model="tensor" only. The rank of the individual mode of the ground
truth (Default: 2).
}
\item{rank_isoform}{
model="tensor" only. The rank of the isoform mode of the ground truth
(Default: 2).
}
\item{individual_effect}{
model="tensor" only. If FALSE, all rows of U are identical so that
B_nci does not depend on n (Simulation 1: the matrix model is
sufficient). If TRUE, B varies across individuals (Simulation 2)
(Default: TRUE).
}
\item{effect_cell_types}{
model="tensor" only. If not NULL, the individual variation is
restricted to the specified cell type indices: component 1 of U is
fixed to a shared component and the core slices of components >= 2
are zeroed outside effect_cell_types. Requires rank_individual >= 2
(Default: NULL, i.e., all cell types can vary).
}
\item{A_variation}{
model="tensor" only. Controls the between-individual variation of the
cell type fractions. One of "none" (identical rows), "low",
"moderate", "high", or a positive number interpreted as the total
Dirichlet concentration alpha0 (rows are Dirichlet(alpha0 * A_mean);
smaller alpha0 means larger variation) (Default: "moderate").
}
\item{A_mean}{
model="tensor" only. A length-C vector of mean cell type fractions
(normalized to sum to 1); use skewed values to create rare cell types
(Default: NULL, i.e., uniform 1/C).
}
\item{noise_A}{
model="tensor" only. The standard deviation of the Gaussian
perturbation applied to A to mimic estimation error of the external
deconvolution: the returned A_obs is the perturbed, re-normalized
fraction matrix, while X is always generated from the true A
(Default: 0).
}
}

\value{
For model="matrix", a list containing X (N x I), A (N x C), B (C x I),
and the specified N, C, I, and noise.

For model="tensor", a list containing X (N x I), A (true, N x C),
A_obs (perturbed A to be used as the input of fitting; identical to A
when noise_A=0), B (N x C x I), the ground truth factors U, G, W, the
specified parameters, and A_summary (diagnostics of A related to
recoverability: rank, condition number, column-wise correlation,
mean fractions, minimum mean fraction, and total variance).
}

\examples{
# Phase 1 (matrix model)
toy <- isoToyModel(N=5, C=2, I=6, seed=1234)
dim(toy$X)

# Phase 2 simulation ground truth (no fitting algorithm yet)
tt <- isoToyModel(model="tensor", N=20, C=3, I=20,
    rank_individual=2, rank_isoform=2,
    A_variation="moderate", seed=1)
dim(tt$B)
tt$A_summary$rank
}

\author{Koki Tsuyuzaki}

\seealso{\code{\link{isoTensor}}}
\keyword{methods}
